<resources>
    <style name="Base.Theme.GitViewer" parent="Theme.Material3.DayNight.NoActionBar" />

    <style name="Theme.GitViewer" parent="Base.Theme.GitViewer">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.GitViewer.Splash" parent="Theme.SplashScreen">
