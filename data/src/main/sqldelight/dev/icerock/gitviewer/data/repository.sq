-- Создание таблицы репозиториев
CREATE TABLE repository (
    id INTEGER NOT NULL PRIMARY KEY,
    owner TEXT NOT NULL,
    name TEXT NOT NULL,
    url TEXT NOT NULL,
    description TEXT,
    language TEXT,
    license TEXT,
    stars_count INTEGER NOT NULL DEFAULT 0,
    forks_count INTEGER NOT NULL DEFAULT 0,
    watchers_count INTEGER NOT NULL DEFAULT 0,
    issues_count INTEGER NOT NULL DEFAULT 0,
    cache_ttl INTEGER NOT NULL
);

-- Индекс для поиска по TTL
CREATE INDEX idx_repositories_ttl ON repository(cache_ttl);

-- Получение всех репозиториев с актуальным TTL
selectAllRepositories:
SELECT * FROM repository
WHERE cache_ttl > :current_timestamp ORDER BY repository.name ASC
LIMIT :limit OFFSET :offset;

-- Подсчёт количества репозиториев (для PagingSource countQuery)
countRepositories:
SELECT COUNT(*) FROM repository
WHERE cache_ttl > :current_timestamp;

-- Получение репозитория по ID
getRepositoryById:
SELECT * FROM repository
WHERE id = :id;

-- Вставка репозитория
insertRepository:
INSERT OR REPLACE INTO repository (id, owner, name, url, description, language, license, stars_count, forks_count, watchers_count, issues_count, cache_ttl)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Обновить количество задач репозитория
updateIssuesCountAtRepository:
UPDATE repository
SET issues_count = :issues_count
WHERE id = :repository_id;

-- Обновление репозитория
updateRepository:
UPDATE repository
SET description = :description,
    language = :language,
    stars_count = :stars_count,
    forks_count = :forks_count,
    issues_count = :issues_count,
    cache_ttl = :cache_ttl
WHERE id = :id;

-- Удаление репозитория
deleteRepository:
DELETE FROM repository WHERE id = :id;

-- Очистка устаревших репозиториев
deleteExpiredRepositories:
DELETE FROM repository
WHERE cache_ttl < :current_timestamp;

deleteAllRepositories:
DELETE FROM repository;